      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Generative text (LLM)",
          "Chat assistant",
          "Document Q&A (RAG)",
          "Classification & NLP",
          "Prediction & forecasting",
          "Computer vision",
          "Speech & transcription",
          "Translation",
          "Agents & automation",
          "Rules-based (no ML)"
        ]
      },
      "uniqueItems": true
    },
    "ai_tools": {
      "title": "Tools and technologies",
