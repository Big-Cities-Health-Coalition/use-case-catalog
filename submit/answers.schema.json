      "type": "string",
      "minLength": 1
    },
    "ai_role": {
      "title": "Role of AI",
      "description": "What part, if any, does AI play? Most digital work involves no AI, and that is a fine answer.",
      "type": "string",
      "enum": [
        "No AI",
        "AI is part of the solution",
        "AI helped build it",
        "Both"
      ]
    },
    "ai_types": {
      "title": "Types of AI",
