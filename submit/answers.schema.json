      "items": {
        "type": "string",
        "enum": [
          "AI/ML model",
          "Generative AI tool",
          "Data pipeline or integration",
          "Analysis project or script",
          "Dashboard or visualization",
          "Application or software",
          "Data platform or infrastructure",
          "Workflow automation",
          "Standards, governance or playbook"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "use_case_category": {
      "title": "AI use category",
      "description": "If it involves AI, which of the four coalition categories fits best? For AI work only: the HHS-adapted categories the DMWG AI inventory uses. Leave it blank if no AI is involved.",
      "type": "string",
      "enum": [
        "Administrative & task automation",
        "Communications, media & writing",
        "Coding & brainstorming",
        "Operations & logistics"
      ]
    },
    "area": {
      "title": "Public health area",
      "description": "Which public health areas does it serve? Select all that fit. The first five follow the program areas of the Foundational Public Health Services; the rest are the capabilities every program relies on.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Communicable disease",
          "Chronic disease and injury prevention",
          "Environmental health",
          "Maternal, child and family health",
          "Access to and linkage with care",
          "Emergency preparedness and response",
          "Epidemiology and surveillance",
          "Vital records and health statistics",
          "Communications and community engagement",
          "Data modernization and informatics",
          "Agency operations and administration"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "stage": {
      "title": "Stage",
      "description": "How far along is it? Pick the stage that matches real use, not the plan.",
      "type": "string",
      "enum": [
        "Idea / exploring",
        "Pilot",
        "In production",
        "Paused or retired"
      ]
    },
    "summary": {
      "title": "Summary",
      "description": "In one or two sentences, what does it do? Shown on the catalog card. Plain language, no jargon.",
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "title": "Result in one line",
      "description": "What is the single most concrete result so far? A number if you have one.",
      "type": "string"
    },
    "organization": {
      "title": "Organization",
